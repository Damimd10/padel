generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompetitionFormat {
  elimination
  round_robin
  league
}

enum CompetitionStatus {
  draft
  open
  closed
  cancelled
}

enum DivisionName {
  masculino
  femenino
  mixto
}

enum RegistrationStatus {
  registered
  pending_review
  approved
  rejected
  withdrawn
}

enum MatchStatus {
  scheduled
  in_progress
  completed
  cancelled
}

model Competition {
  id                     String            @id @default(uuid())
  title                  String
  description            String?
  format                 CompetitionFormat
  startsAt               DateTime
  endsAt                 DateTime
  regStartsAt            DateTime?
  regEndsAt              DateTime?
  maxTeams               Int?
  pricePerTeam           Int               @default(0)
  isPublic               Boolean           @default(true)
  requiresApproval       Boolean           @default(false)
  hasWaitlist            Boolean           @default(true)
  groupCount             Int?
  teamsPerGroup          Int?
  setsToWin              Int               @default(2)
  gamesPerSet            Int               @default(6)
  tiebreakPoints         Int               @default(7)
  goldenPoint            Boolean           @default(false)
  matchDurationMinutes   Int               @default(60)
  firstMatchTime         String?
  lastMatchTime          String?
  breakBetweenMatchesMinutes Int           @default(15)
  autoGenerateSchedule   Boolean           @default(true)
  earlyBirdDiscount      Int               @default(0)
  isFreeEntry            Boolean           @default(false)
  ownerId                String
  status                 CompetitionStatus
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  categories    Category[]
  divisions     Division[]
  registrations Registration[]
  matches       Match[]
  courts        Court[]
  prizes        Prize[]
}

model Category {
  id             String       @id @default(uuid())
  competitionId  String
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  label          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([competitionId, label])
  @@index([competitionId])
}

model Division {
  id             String       @id @default(uuid())
  competitionId  String
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name           DivisionName
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([competitionId, name])
  @@index([competitionId])
}

model Registration {
  id             String           @id @default(uuid())
  competitionId  String
  competition    Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participantId  String
  categoryId     String
  divisionId     String
  status         RegistrationStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  matchesAsA Match[] @relation("MatchRegistrationA")
  matchesAsB Match[] @relation("MatchRegistrationB")

  @@index([competitionId])
  @@index([participantId, competitionId])
  @@unique([participantId, competitionId])
}

model Match {
  id              String        @id @default(uuid())
  competitionId   String
  competition     Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  registrationAId String
  registrationA   Registration  @relation("MatchRegistrationA", fields: [registrationAId], references: [id])
  registrationBId String
  registrationB   Registration  @relation("MatchRegistrationB", fields: [registrationBId], references: [id])
  status          MatchStatus
  scheduledAt     DateTime?
  scoreA          Int?
  scoreB          Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([competitionId])
  @@index([competitionId, status])
}

model Court {
  id            String       @id @default(uuid())
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  type          String
  isSelected    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([competitionId])
}

model Prize {
  id            String       @id @default(uuid())
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  place         String
  amount        Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([competitionId])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
